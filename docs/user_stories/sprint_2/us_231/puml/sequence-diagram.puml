@startuml
skinparam handwritten true
skinparam monochrome true
skinparam packageStyle rect
skinparam defaultFontName FG Virgil
skinparam shadowing false

actor "CRM Collaborator" as Actor
participant ListPublicFiguresCatalogueUI as UI <<presentation>>
participant ListPublicFiguresCatalogueController as Controller <<application>>
participant FigureDTOParser as DtoParser <<application>>
database Catalogue as Repository <<repository>>

Actor --> UI: List Public Figures
activate UI
    UI -> Controller: create

        UI -> Controller : listUsers()
        activate Controller

            note right of Controller : hidden authorization user guarantee \n(see specific diagram)

            note right of Controller : Simplified persistence\n(see specific diagram)

            Controller -> Repository : findAllPublic()
            activate Repository

            Repository --> Controller : publicFigures
            deactivate Repository

            Controller -> DtoParser : transformToDTO(publicFigures)
            activate DtoParser

            DtoParser --> Controller : publicFiguresDTO
            deactivate DtoParser

        Controller --> UI : publicFiguresDTO
        deactivate Controller

UI --> Actor: Show Public Figures
deactivate UI
@enduml
