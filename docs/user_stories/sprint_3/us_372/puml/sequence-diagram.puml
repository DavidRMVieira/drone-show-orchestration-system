@startuml
skinparam handwritten true
skinparam monochrome true
skinparam packageStyle rect
skinparam defaultFontName FG Virgil
skinparam shadowing false

actor "Customer" as Actor
participant ListScheduledShowsUI as UI <<presentation>>
participant ListScheduledShowsController as Controller <<application>>
participant ListShowProposalService as proposalSvc <<application>>
participant AuthorizationService as authSvc <<application>>
participant ShowProposalDTOParser as proposalParser <<application>>
participant Customer as customerDomain <<domain>>
database ShowProposalRepository as Repository <<repository>>
database CustomerRepository as customerRepository <<repository>>

Actor --> UI: Check Shows Dates
activate UI

    UI -> Controller: listScheduledShows()
    activate Controller

    note right of Controller : hidden authorization user guarantee \n(see specific diagram)

    note right of Controller : Simplified persistence\n(see specific diagram)

        Controller -> authSvc : authenticatedUser()
        activate authSvc

        authSvc --> Controller : currentUser
        deactivate authSvc

        Controller -> customerRepository : findByUser(currentUser)
        activate customerRepository

        customerRepository --> Controller : currentCustomer
        deactivate customerRepository

        Controller -> customerDomain : customer
        activate customerDomain

        customerDomain --> Controller : customer
        deactivate customerDomain

        Controller -> proposalSvc : allScheduledShowsByCustomer(customer)
        activate proposalSvc

                    proposalSvc -> Repository : findScheduledShowsByCustomer(customer)
                    activate Repository

                    Repository --> proposalSvc : proposals
                    deactivate Repository

                    proposalSvc -> proposalParser : transformToDTO(proposals)
                    activate proposalParser

                    proposalParser --> proposalSvc : proposalsDTO
                    deactivate proposalParser

        proposalSvc --> Controller : proposalsDTO
        deactivate proposalSvc

    Controller --> UI: proposalsDTO
    deactivate Controller

    UI --> Actor: Show list of scheduled shows
    deactivate UI

@enduml
