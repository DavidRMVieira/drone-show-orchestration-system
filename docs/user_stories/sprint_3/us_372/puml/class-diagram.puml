@startuml
skinparam classAttributeIconSize 0
hide empty attributes

package "Presentation" {
    class ListScheduledShowsUI <<presentation>> {
    }
}

package "Application" {
    class ListScheduledShowsController <<application>> {
        +listScheduledShows() : Iterable<ShowProposalDTO>
    }

    class AuthorizationService <<application>> {
        +authenticatedUser() : SystemUser
    }

    class ListShowProposalService <<application>> {
        +allScheduledShowsByCustomer(customer) : Iterable<ShowProposalDTO>
    }

    class ShowProposalDTOParser <<application>> {
        +transformToDTO(proposals) : Iterable<ShowProposalDTO>
    }
}

package "Persistence" {
    class ShowProposalRepository <<repository>> {
        +findScheduledShowsByCustomer(customer) : Iterable<ShowProposal>
    }

    class CustomerRepository <<repository>> {
        +findByUser(currentUser) : Customer
    }
}

package "DTO" {
    class ShowProposalDTO <<dto>> {
    }
}

package "Domain" {

package "<<aggregate>> Customer" {
    class Customer <<entity>> <<root>> {
    }

    enum CustomerState <<value object>> {
    }

    enum CustomerType <<value object>> {
    }

    class Name <<value object>> {
    }

    class VAT <<value object>> <<id>> {
    }

    class Address <<value object>> {
    }

    Customer --> "1" VAT
    Customer --> "1" Address
    Customer --> "1" CustomerState
    Customer --> "1" CustomerType
    Customer --> "1" Name
}

package "<<aggregate>> ShowRequest" {
    class ShowRequest <<entity>> <<root>> {
    }

    class ShowRequestID <<value object>> <<id>> {
    }

    class Place <<value object>> {
    }

    class Date <<value object>> {
    }

    class Duration <<value object>> {
    }

    enum ShowRequestState <<value object>> {
    }

    ShowRequest --> "1" ShowRequestID
    ShowRequest --> "1" Date
    ShowRequest --> "1" Place
    ShowRequest --> "1" Duration
    ShowRequest --> "1" ShowRequestState
}

package "<<aggregate>> ShowProposal" {
    class ShowProposal <<entity>> <<root>> {
        - numberDrones : int
    }

    class ShowProposalID <<value object>> <<id>> {
    }

    class Location <<value object>> {
    }

    class Date <<value object>> {
    }

    class Duration <<value object>> {
    }

    class VideoFile <<value object>> {
    }

    class Language <<value object>> {
    }

    class Money <<value object>> {
    }

    enum ShowProposalState <<value object>> {
    }

    class DroneInShow <<value object>> {
        -quantity : int
    }

    class FigureInShow <<value object>> {
        -coordinateX : double
        -coordinateY : double
        -coordinateZ : double
    }

    class SimulationLog <<entity>> {
    }

    enum SimulationResult <<value object>> {
    }

    ShowProposal --> "1" ShowProposalID
    ShowProposal --> "1" Date
    ShowProposal --> "1" Location
    ShowProposal --> "1" Duration
    ShowProposal --> "1" VideoFile
    ShowProposal --> "1" Money
    ShowProposal --> "1" Language
    ShowProposal --> "1" ShowProposalState
    ShowProposal --> "*" DroneInShow
    ShowProposal --> "*" FigureInShow
    ShowProposal --> "*" SimulationLog
    SimulationLog --> "1" Date
    SimulationLog --> "1" SimulationResult
}

package "<<aggregate>> ShodroneUser" {
    class ShodroneUser <<entity>> <<root>> {
    }

    class Role <<value object>> {
    }

    class PhoneNumber <<value object>> {
    }

    class ShodroneEmail <<value object>> <<id>> {
    }

    ShodroneUser --> "1..*" Role
    ShodroneUser --> "1" ShodroneEmail
    ShodroneUser --> "1" PhoneNumber
}

ShowRequest "*" --> "1" Customer : requested by
ShowProposal "*" --> "1" ShowRequest : proposes
DroneInShow "*" -- "1" DroneModel : reference
FigureInShow "*" -- "1" Figure : reference

}

' Relationships
ListScheduledShowsUI --> ListScheduledShowsController : uses

ListScheduledShowsController --> ListShowProposalService : proposalSvc
ListScheduledShowsController --> AuthorizationService : auth
ListScheduledShowsController --> CustomerRepository : customerRepo
ListShowProposalService --> ShowProposalDTOParser : parser

ShowProposalDTOParser --> ShowProposalDTO : proposalDto
ListShowProposalService --> ShowProposalRepository : proposalRepo

AuthorizationService --> ShodroneUser : currentUser
CustomerRepository --> Customer : currentCustomer
ShowProposalRepository --> ShowProposal : proposal

@enduml
