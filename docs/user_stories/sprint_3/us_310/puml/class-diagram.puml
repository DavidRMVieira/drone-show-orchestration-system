@startuml
skinparam classAttributeIconSize 0
hide empty attributes

package "Presentation" {
    class CreateShowProposalUI <<presentation>> {
    }
}

package "Application" {
    class CreateShowProposalController <<application>> {
        +createShowProposal(proposalDTO, selectedRequestDTO, selectedRepresentativeDTO) : ShowProposalDTO
        +listShowRequests() : Iterable<ShowRequestDTO>
        +listCustomerRepresentatives(selectedRequestDTO) : Iterable<RepresentativeDTO>
    }

    class RepresentativeDTOParser <<application>> {
        +transformToDTO(customerRepresentatives) : Iterable<RepresentativeDTO>
        +valueOf(selectedRepresentativeDTO) : Representative
    }

    class ShowRequestDTOParser <<application>> {
        +transformToDTO(showRequests) : Iterable<ShowRequestDTO>
        +valueOf(selectedRequestDTO) : ShowRequest
    }
}

package "Builder" {
    class ShowProposalBuilder <<builder>> {

    }
}

package "Persistence" {
    class ShowProposalRepository <<repository>> {
        +save(proposal) : ShowProposal
    }

    class ShowRequestRepository <<repository>> {
        +findAllByCustomer(customer) : Iterable<ShowRequest>
        +ofIdentity(showRequestID) : ShowRequest
    }

    class RepresentativeRepository <<repository>> {
        +findAll() : Iterable<Representative>
        +ofIdentity(representativeEmail) : Representative
    }
}

package "DTO" {
    class ShowProposalDTO <<dto>> {
    }

    class ShowRequestDTO <<dto>> {
    }

    class RepresentativeDTO <<dto>> {
    }
}

package "Domain" {

package "<<aggregate>> Representative" {
    class Representative <<entity>> {
    }

    class Position <<value object>> {
    }

    class EmailAddress <<value object>> <<id>> {
    }

    Representative --> "1" Position
    Representative --> "1" EmailAddress
}

package "<<aggregate>> Customer" {
    class Customer <<entity>> <<root>> {
    }

    enum CustomerState <<value object>> {
    }

    enum CustomerType <<value object>> {
    }

    class Name <<value object>> {
    }

    class VAT <<value object>> <<id>> {
    }

    class Address <<value object>> {
    }

    Customer --> "1" VAT
    Customer --> "1" Address
    Customer --> "1" CustomerState
    Customer --> "1" CustomerType
    Customer --> "1" Name
}

package "<<aggregate>> ShowRequest" {
    class ShowRequest <<entity>> <<root>> {
    }

    class ShowRequestID <<value object>> <<id>> {
    }

    class Place <<value object>> {
    }

    class Date <<value object>> {
    }

    class Duration <<value object>> {
    }

    enum ShowRequestState <<value object>> {
    }

    ShowRequest --> "1" ShowRequestID
    ShowRequest --> "1" Date
    ShowRequest --> "1" Place
    ShowRequest --> "1" Duration
    ShowRequest --> "1" ShowRequestState
}

package "<<aggregate>> ShowProposal" {
    class ShowProposal <<entity>> <<root>> {
        - numberDrones : int
    }

    class ShowProposalID <<value object>> <<id>> {
    }

    class Location <<value object>> {
    }

    class Date <<value object>> {
    }

    class Duration <<value object>> {
    }

    class VideoFile <<value object>> {
    }

    class Language <<value object>> {
    }

    class Money <<value object>> {
    }

    enum ShowProposalState <<value object>> {
    }

    class DroneInShow <<value object>> {
        -quantity : int
    }

    class FigureInShow <<value object>> {
    }

    class DroneModelName <<value object>> {
    }

    class FigureCode <<value object>> {
    }

    class PositionInShow <<value object>> {
    }

    ShowProposal --> "1" ShowProposalID
    ShowProposal --> "1" Date
    ShowProposal --> "1" Location
    ShowProposal --> "1" Duration
    ShowProposal --> "1" VideoFile
    ShowProposal --> "1" Money
    ShowProposal --> "1" Language
    ShowProposal --> "1" ShowProposalState
    ShowProposal --> "*" DroneInShow
    ShowProposal --> "*" FigureInShow
    DroneInShow --> "1" DroneModelName
    FigureInShow --> "1" FigureCode
    FigureInShow --> "1" PositionInShow
}

Customer "1" <-- "*" Representative : represents
ShowRequest "*" --> "1" Customer : requested by
ShowProposal "*" --> "1" ShowRequest : proposes
ShowProposal "*" --> "0..1" Representative : exclusive to

}

' Relationships
CreateShowProposalUI --> CreateShowProposalController : uses

CreateShowProposalController --> ShowProposalRepository : showProposalRepository
CreateShowProposalController --> ShowRequestRepository : showRequestRepository
CreateShowProposalController --> RepresentativeRepository : representativeRepository

CreateShowProposalController --> ShowProposal : proposal
CreateShowProposalController --> ShowProposalDTO : proposalDTO

CreateShowProposalController --> ShowProposalBuilder : proposalBuilder

CreateShowProposalController --> RepresentativeDTOParser : representativeParser
CreateShowProposalController --> ShowRequestDTOParser : requestParser

ShowProposalBuilder --> ShowProposal : proposal

RepresentativeDTOParser --> RepresentativeDTO : representativeDTO
ShowRequestDTOParser --> ShowRequestDTO : requestDTO

@enduml