@startuml
skinparam handwritten true
skinparam monochrome true
skinparam packageStyle rect
skinparam defaultFontName FG Virgil
skinparam shadowing false

actor "CRM Collaborator" as Actor
participant AddVideoSimulationProposalUI as UI <<presentation>>
participant AddVideoSimulationProposalController as Controller <<application>>
participant ListShowProposalService as proposalSvc <<application>>
participant ShowProposalDTOParser as proposalParser <<application>>
participant ShowProposal as Domain <<domain>>
participant ShowProposalDTO as DTO <<dto>>
database ShowProposalRepository as Repository <<repository>>

Actor --> UI: Add Video Simulation Proposal
activate UI

    UI -> Controller: listShowProposals()
    activate Controller

    note right of Controller : hidden authorization user guarantee \n(see specific diagram)

    note right of Controller : Simplified persistence\n(see specific diagram)

        Controller -> proposalSvc : allShowProposals()
        activate proposalSvc

                    proposalSvc -> Repository : findAll()
                    activate Repository

                    Repository --> proposalSvc : requests
                    deactivate Repository

                    proposalSvc -> proposalParser : transformToDTO(proposals)
                    activate proposalParser

                    proposalParser --> proposalSvc : proposalsDTO
                    deactivate proposalParser

        proposalSvc --> Controller : proposalsDTO
        deactivate proposalSvc

    Controller --> UI: proposalsDTO
    deactivate Controller

    UI --> Actor: Show list of show proposals
    Actor --> UI: Select show proposal

    UI --> Actor: Request video simulation link
    Actor --> UI: Provide video simulation link

    UI -> Controller: addVideoSimulationProposal(selectedProposalDTO, videoLink)
    activate Controller

        Controller -> DTO : id()
        activate DTO

        DTO --> Controller : proposalID
        deactivate DTO

        Controller -> proposalSvc : findShowProposalByID(proposalID)
        activate proposalSvc

                    proposalSvc -> Repository : ofIdentity(proposalID)
                    activate Repository

                    Repository --> proposalSvc : proposal
                    deactivate Repository

        proposalSvc --> Controller : proposal
        deactivate proposalSvc

        Controller -> Domain : addVideoSimulation(videoLink)
        activate Domain

        Domain --> Controller : void
        deactivate Domain

        Controller -> Repository: save(proposal)
        activate Repository

        Repository --> Controller: proposal
        deactivate Repository

        Controller --> UI:
    deactivate Controller

UI --> Actor: Display success or error message
deactivate UI

@enduml