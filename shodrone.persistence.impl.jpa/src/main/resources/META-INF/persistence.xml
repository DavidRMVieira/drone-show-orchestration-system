<?xml version="1.0" encoding="UTF-8"?>
<persistence version="2.1"
             xmlns="http://xmlns.jcp.org/xml/ns/persistence">
  <persistence-unit name="SHODRONE_PU">
    <!-- <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider> -->
    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

    <class>eapli.framework.infrastructure.pubsub.impl.simplepersistent.model.EventRecord</class>
    <class>eapli.framework.infrastructure.pubsub.impl.simplepersistent.model.EventConsumption</class>
    <class>eapli.framework.infrastructure.authz.domain.model.SystemUser</class>
    <class>eapli.framework.infrastructure.authz.domain.model.Role</class>
    <class>eapli.framework.infrastructure.authz.domain.model.RoleSet</class>
    <class>eapli.framework.infrastructure.authz.domain.model.RoleAssignment</class>
    <class>lapr4.usermanagement.domain.ShodroneUser</class>
    <class>lapr4.customermanagement.domain.Customer</class>
    <class>lapr4.customermanagement.domain.Representative</class>
    <class>lapr4.showrequestmanagement.domain.ShowRequest</class>
    <class>lapr4.figurecatalogue.domain.Figure</class>
    <class>lapr4.figurecatalogue.domain.DSL</class>
    <class>lapr4.figurecategorymanagement.domain.FigureCategory</class>
    <class>lapr4.droneinventory.domain.DroneModel</class>
    <class>lapr4.droneinventory.domain.Drone</class>
    <class>lapr4.showproposalmanagement.domain.ShowProposal</class>
    <class>lapr4.integrations.dronelanguageplugin.domain.DroneLanguagePlugin</class>
    <class>lapr4.integrations.dslplugin.domain.DSLPlugin</class>
    <class>lapr4.integrations.proposaltemplate.domain.ProposalTemplate</class>
    <class>lapr4.showproposalmanagement.events.AbstractShowProposalEvent</class>
    <class>lapr4.showproposalmanagement.events.ShowProposalSentEvent</class>
    <class>lapr4.showproposalmanagement.events.ShowProposalAcceptedEvent</class>
    <class>lapr4.showproposalmanagement.events.ShowProposalRejectedEvent</class>
    <class>lapr4.showproposalmanagement.events.ShowProposalAcceptedByCRMEvent</class>

    <properties>
      <!-- Database configuration. -->
      <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:./bd/shodrone" />

      <property name="jakarta.persistence.jdbc.user" value="user" />
      <property name="jakarta.persistence.jdbc.password" value="password" />
      <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver" />

      <!-- If you want to view the SQLs generated by Hibernate, uncomment this line -->
      <!-- <property name = "hibernate.show_sql" value = "true" /> -->
      <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect" />

      <!-- <property name="hibernate.hbm2ddl.auto" value="create-drop" /> -->

      <!-- Hibernate C3PO Connection Pooling -->
      <property name="hibernate.c3p0.provider"
                value="org.hibernate.c3p0.internal.C3P0ConnectionProvider"/>
      <property name="hibernate.c3p0.min_size" value="5" />
      <property name="hibernate.c3p0.max_size" value="20" />
      <property name="hibernate.c3p0.timeout" value="300" />
      <property name="hibernate.c3p0.max_statements" value="50" />
      <property name="hibernate.c3p0.idle_test_period" value="120" />
    </properties>
  </persistence-unit>
</persistence>